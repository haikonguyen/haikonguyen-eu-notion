# Copy to .env.local and fill in real values (never commit secrets).

# Cloudflare R2 (CMS media — blog covers now; portfolio/ later)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Optional: SendGrid contact form
SENDGRID_API_KEY=

# Keystatic local storage needs no secrets for the POC.
# Admin UI: npm run dev:keystatic (Webpack — Turbopack has a known @keystar/ui bug).
# Cover uploads: PUT via createR2UploadUrl server action, or manual upload + paste public URL/key into Keystatic.
