# Copy to .env.local and fill in real values (never commit secrets).

# Cloudflare R2 (CMS media — covers + inline Markdoc images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Optional: SendGrid contact form + checkout / booking confirmations
SENDGRID_API_KEY=

# Optional: Google Calendar booking (service account)
# Share the target calendar with the service-account email (Make changes to events).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Optional: Supabase auth (Epic 5 + CMS-10 admin gate)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated allowlist for /keystatic + /api/keystatic/*
KEYSTATIC_ADMIN_EMAILS=
# Production: set true to expose Admin UI (otherwise 404)
KEYSTATIC_ADMIN_ENABLED=
# When true (or allowlist is set), require a signed-in allowlisted session
KEYSTATIC_REQUIRE_AUTH=

# Keystatic local storage needs no secrets for the POC.
# Admin UI: npm run dev:keystatic (Webpack — Turbopack has a known @keystar/ui bug).
# Inline images: insert the "R2 Image" block in Markdoc, then either
#   1) drop an image (uploads to R2 when env is set), or
#   2) paste a public R2 URL / object key.
# Prefixes: blog/covers, blog/inline, about, portfolio.
